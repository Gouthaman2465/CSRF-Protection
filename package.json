{
  "name": "csrf-protection",
  "version": "1.0.0",
  "description": "CSRF protection middleware, attack lab, bypass demonstrations, and automated verification suite",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node src/server.js",
    "lab:off": "node scripts/lab.js --mode=off",
    "lab:weak-token": "node scripts/lab.js --mode=weak-token",
    "lab:weak-referer": "node scripts/lab.js --mode=weak-referer",
    "lab:secure": "node scripts/lab.js --mode=secure",
    "browsers": "playwright install chromium",
    "test": "jest tests/unit tests/integration --runInBand",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "keywords": [
    "csrf",
    "security",
    "express",
    "appsec",
    "cybersecurity"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.2"
  }
}
